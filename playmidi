#!/usr/bin/env python3
import sys
import time
import argparse
import mido

def main():
    parser = argparse.ArgumentParser(description="Play MIDI file with speed control to ALSA/Pianoteq")
    parser.add_argument("file", help="Path to MIDI file")
    parser.add_argument("-s", "--speed", type=float, default=1.0, help="Playback speed multiplier (e.g. 0.8 for 80%% tempo, 1.2 for 120%%). Default: 1.0")
    parser.add_argument("-v", "--volume", type=float, default=1.0, help="Playback volume multiplier (0.0 to 1.0, e.g. 0.8 for 80%% velocity). Default: 1.0")
    parser.add_argument("-p", "--port", default="Midi Through", help="ALSA MIDI output port (name or substring, default: 'Midi Through')")
    parser.add_argument("--allow-program-change", action="store_true", default=False, help="Allow MIDI Program Change and Bank Select events (default: ignored)")
    args = parser.parse_args()
    ignore_pc = not args.allow_program_change

    if args.speed <= 0:
        print("Error: speed must be greater than 0", file=sys.stderr)
        sys.exit(1)

    vol = args.volume
    if vol > 1.0:
        vol = vol / 100.0
    vol = max(0.0, min(1.0, vol))

    outputs = mido.get_output_names()
    target_port = None
    for name in outputs:
        if args.port in name or args.port in name.split()[-1]:
            target_port = name
            break

    if not target_port:
        if outputs:
            target_port = outputs[0]
        else:
            print("Error: No MIDI output ports found!", file=sys.stderr)
            sys.exit(1)

    mid = mido.MidiFile(args.file)
    total_length = mid.length / args.speed
    mins, secs = divmod(int(total_length), 60)
    print(f"Playing '{args.file}' -> {target_port}")
    print(f"Speed: {args.speed}x | Volume: {int(round(vol*100))}% | Duration: {mins:02d}:{secs:02d} | Ignore PC: {ignore_pc}")

    with mido.open_output(target_port) as port:
        start_time = time.time()
        try:
            for msg in mid:
                if msg.time > 0:
                    time.sleep(msg.time / args.speed)
                if not msg.is_meta:
                    if ignore_pc:
                        if msg.type == 'program_change' or (msg.type == 'control_change' and msg.control in (0, 32)):
                            continue
                    msg_to_send = msg.copy()
                    if msg_to_send.type == 'note_on' and getattr(msg_to_send, 'velocity', 0) > 0:
                        if vol <= 0.0:
                            msg_to_send.velocity = 0
                        else:
                            msg_to_send.velocity = max(1, min(127, int(round(msg_to_send.velocity * vol))))
                    port.send(msg_to_send)
                elapsed = time.time() - start_time
                e_min, e_sec = divmod(int(elapsed), 60)
                sys.stdout.write(f"\rTime: {e_min:02d}:{e_sec:02d} / {mins:02d}:{secs:02d} [{int((elapsed/max(1,total_length))*100):3d}%%]")
                sys.stdout.flush()
        except KeyboardInterrupt:
            print("\nStopped.")
        finally:
            # Send all notes off on all channels
            for ch in range(16):
                port.send(mido.Message('control_change', channel=ch, control=123, value=0))
                port.send(mido.Message('control_change', channel=ch, control=120, value=0))
            print("\nDone.")

if __name__ == '__main__':
    main()
